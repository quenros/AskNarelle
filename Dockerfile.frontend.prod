FROM node:20-bullseye AS builder

WORKDIR /app/admin-app

# Install dependencies
COPY admin-app/package*.json ./
RUN npm ci || npm install

# Copy source and build
COPY admin-app/. .
RUN npm run build

# Production stage
FROM node:20-bullseye AS runner

WORKDIR /app/admin-app

# Copy built app
COPY --from=builder /app/admin-app/.next ./.next
COPY --from=builder /app/admin-app/node_modules ./node_modules
COPY --from=builder /app/admin-app/package.json ./package.json
COPY --from=builder /app/admin-app/public ./public
COPY --from=builder /app/admin-app/next.config.mjs ./

# Expose port
EXPOSE 3000

# Start the app
CMD ["npm", "run", "start"]